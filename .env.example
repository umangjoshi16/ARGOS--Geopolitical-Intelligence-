# ==============================================================================
# ARGOS — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=0.0.0.0
DEBUG=false

# Global Tension Index (GTI) Calibration Parameters
# k_value: Saturation constant where typical multi-crisis days land at 65-75 pts
GTI_CALIBRATION_K=2850.0
# half_life_hours: Exponential decay rate (hours until incident weight fades by 50%)
GTI_HALF_LIFE_HOURS=72.0
# auto_refresh_interval_sec: Automated background polling frequency (15 minutes)
AUTO_REFRESH_INTERVAL_SECONDS=900

# Optional External API Keys (ARGOS includes built-in live Yahoo Finance & RSS ingestion)
# Gemini API Key (Optional: for impact translation summaries & advanced LLM reasoning)
GEMINI_API_KEY=

# NewsAPI / GNews Key (Optional: for extended news syndication)
NEWS_API_KEY=

# Alpha Vantage / Twelve Data (Optional: for alternative commodity benchmarks)
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
